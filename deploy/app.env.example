# Copiar a /etc/correo-automatizado/app.env y protegerlo; nunca versionar el archivo real.
APP_ENV=production
FLASK_SECRET_KEY=

# Completar con los valores SMTP confirmados antes de iniciar el worker:
# SMTP_SERVER=
# SMTP_PORT=
# SMTP_USUARIO=
# CORREO_ORIGEN=
# NOMBRE_REMITENTE=

# Opcional; si no se define, la aplicacion usa /var/lib/correo-automatizado.
# APP_DATA_DIR=/var/lib/correo-automatizado
# MAX_SPREADSHEET_ROWS=10000
